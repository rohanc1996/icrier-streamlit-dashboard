---
import BaseLayout from '../components/BaseLayout.astro';
import FlagSprite from '../components/FlagSprite.astro';
import OverviewCarousel from '../components/OverviewCarousel.tsx';
import { meta } from '../lib/data';
import { buildOverviewView, overviewFlagIso2s } from '../lib/overview';

const overview = buildOverviewView();
const field = overview.field;
const flagIso2s = overviewFlagIso2s();
---

<BaseLayout
  title={`CHIPS ${meta.edition} overview · SIDE`}
  description={`Eight views of the SIDE ${meta.edition} CHIPS index: the field, the top 15, how a score is built, India's five pillars, movement between editions, two scaling methods, GDP and coverage.`}
  noteScale={overview.defaultMethod}
>
  <div class="container page">
    <FlagSprite iso2s={flagIso2s} />
    <header class="page-head">
      <div class="page-head__main">
        <h1 class="display-l">CHIPS {meta.edition}</h1>
        <p class="body-l lede">
          A digital-economy score for {meta.countries} countries, from {meta.leaves} indicators
          in five areas. Eight views, one index.
        </p>
        <p class="body-s">
          <a href="/rankings">All {meta.countries} ranks →</a>
          {' · '}
          <a href="/methodology#values-to-100">How the score works →</a>
        </p>
      </div>
      <p class="body-s page-head__meta">
        Edition {meta.edition} · {field.count} countries
      </p>
    </header>

    <p class="body-s hint overview-intro">
      Move between panes with the arrows, the dots, or the ← and → keys. Every pane has a
      “View as table” disclosure with the same numbers as its chart. The scale control
      re-scores every pane; pane 6 is the exception, because it compares the two methods.
    </p>

    <OverviewCarousel
      client:load
      panes={overview.panes}
      methods={overview.methods}
      defaultMethod={overview.defaultMethod}
      label={`Overview of the CHIPS ${meta.edition} index`}
    />
  </div>
</BaseLayout>
