---
import BaseLayout from '../components/BaseLayout.astro';
import FlagSprite from '../components/FlagSprite.astro';
import OverviewExplorer from '../components/OverviewExplorer.tsx';
import { allFlagIso2s, allPointIso3s, meta } from '../lib/site';

const flagIso2s = allFlagIso2s();
const pointIso3s = allPointIso3s();
const edition = meta.edition;
---

<BaseLayout
  title={`CHIPS ${edition} overview · SIDE`}
  description={`Seven views of the SIDE ${edition} CHIPS index: the field, every score, how a score is built, the selected country's pillars, rank movement, two normalizations, GDP and score.`}
  noteScale={meta.defaultMethod}
>
  <div class="container page">
    <FlagSprite iso2s={flagIso2s} pointIso3s={pointIso3s} />
    <header class="page-head">
      <div class="page-head__main">
        <h1 class="display-l">CHIPS {edition}</h1>
        <p class="body-l lede">
          A digital-economy score for {meta.editionCountryCount[edition]} countries, from{' '}
          {meta.leaves} indicators in five areas. Seven views, one index.
        </p>
        <p class="body-s">
          <a href="/rankings">All ranks →</a>
          {' · '}
          <a href="/methodology#values-to-100">How the score works →</a>
        </p>
      </div>
      <p class="body-s page-head__meta">
        Edition {edition} · {meta.editionCountryCount[edition]} countries
      </p>
    </header>

    <p class="body-s hint overview-intro">
      Use the filters to choose a score basis, one or more years, and a country
      grouping. Every pane follows, and the address bar keeps the view: copy the URL
      to share it. Move between panes with the arrows, the dots, or the ← and → keys.
    </p>

    <OverviewExplorer client:load label={`Overview of the CHIPS ${edition} index`} />
  </div>
</BaseLayout>
