---
import CountrySearch from './CountrySearch.tsx';
import { pillars } from '../lib/data';

interface Props {
  countries: Array<{ iso3: string; name: string; fullName: string }>;
  scaleIds: string[];
  defaultScale: string;
}

const { countries, scaleIds, defaultScale } = Astro.props;
const path = Astro.url.pathname;
const overviewCurrent = path === '/';
// A country profile is reached from the rankings table, so it keeps that tab
// current rather than adding a fifth item.
const rankingsCurrent = path === '/rankings' || path.startsWith('/country/');
const methodologyCurrent = path === '/methodology';
const aboutCurrent = path === '/about';

// The header strip is the same five pillar colours the charts use, sliced by
// each pillar's share of the index. Built from the framework so an edition
// with different weights (or a renamed pillar) cannot drift from the CSS.
const PILLAR_COLOURS: Record<string, string> = {
  CONNECT: 'var(--pillar-connect)',
  HARNESS: 'var(--pillar-harness)',
  INNOVATE: 'var(--pillar-innovate)',
  PROTECT: 'var(--pillar-protect)',
  SUSTAINABILITY: 'var(--pillar-sustainability)',
};
const totalWeight = pillars.reduce((total, pillar) => total + pillar.weight, 0) || 1;
let cursor = 0;
const pillarStops = pillars
  .map((pillar) => {
    const from = (cursor / totalWeight) * 100;
    cursor += pillar.weight;
    const to = (cursor / totalWeight) * 100;
    return `${PILLAR_COLOURS[pillar.id] ?? 'var(--ink-muted)'} ${from.toFixed(2)}% ${to.toFixed(2)}%`;
  })
  .join(', ');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__wordmark" href="/">
      {/* The wordmark carries the link's accessible name, so the mark is
          decorative here — not alt="ICRIER", which would rename the link. */}
      <img
        class="site-header__logo"
        src="/brand/icrier-logo.png"
        alt=""
        width="180"
        height="97"
        decoding="async"
      />
      <span>SIDE Report</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a href="/" aria-current={overviewCurrent ? 'page' : undefined}>Overview</a>
      <a href="/rankings" aria-current={rankingsCurrent ? 'page' : undefined}>Rankings</a>
      <a href="/methodology" aria-current={methodologyCurrent ? 'page' : undefined}>
        How the index works
      </a>
      <a href="/about" aria-current={aboutCurrent ? 'page' : undefined}>About</a>
    </nav>
    <CountrySearch
      client:idle
      countries={countries}
      scaleIds={scaleIds}
      defaultScale={defaultScale}
    />
  </div>
  <div
    class="pillar-strip"
    style={`background: linear-gradient(90deg, ${pillarStops})`}
    aria-hidden="true"
  />
</header>
